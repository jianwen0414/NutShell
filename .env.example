# Chain
# 🔒 Do NOT use https://mainnet.base.org — it is rate-limited and throttles the
# moment the agent polls in a loop, producing mystery timeouts that look like
# bugs in your own code (PRD §6.2). Use a free Alchemy or Infura key.
#
# Note the Alchemy free tier caps eth_getLogs at a 10-BLOCK range. Point reads
# (eth_call, receipts) are unaffected, which is why the execution path uses
# only those; anything scanning history must page in 10-block windows.
THETANUTS_RPC_URL=            # Alchemy/Infura Base Mainnet

# 🔒 Burner wallet ONLY, holding just the premium budget (~5 USDC + ~$2 ETH).
# Worker process only — never expose this to a Next.js route (PRD §5.1, §14).
# Leave unset for read-only and dry-run work; every read path works without it.
THETANUTS_PRIVATE_KEY=        # burner only — worker process only

# Optional referrer address for OptionBook fee sharing.
THETANUTS_REFERRER=

# Gonka
GONKA_API_KEY=
GONKA_BASE_URL=https://api.gonkarouter.io/v1
# V3 RESOLVED 31 Aug 2026: devshard ids DO resolve on chain, so this is true.
# Set to false only to force the non-linking UI branch.
GONKA_ID_CHAIN_RESOLVABLE=true
# Public Gonka chain REST endpoint. Inferences are recorded here with
# executed_by and response_hash; see `npm run verify:chain`.
GONKA_CHAIN_API=https://node1.gonka.ai:8443/chain-api
# Deferred hedge: send a duplicate analyst call if the first has not finished
# in this long. Gonka support suggested 1.5-2s, but that assumes streaming and
# time-to-first-token; for a non-streaming call that would duplicate every
# request. 14s sits above the normal completion band for the reliable models.
GONKA_HEDGE_AFTER_MS=14000

# Database (Supabase / PostgreSQL)
# Paste your Supabase Connection String (URI) below.
# Located in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Recommended for Serverless: Transaction Pooler URI (port 6543)
# e.g. postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional Supabase API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

OPERATOR_TOKEN=change-me-before-deploying

# Telegram Notifications (Monitor Only Mode)
# Create a bot via @BotFather to get the token.
# Find your personal/group chat ID via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vault (simulated). VAULT_PRINCIPAL_USDC is the MODELLED PORTFOLIO, not the
# burner wallet. DAILY_CAP_PCT is a percentage of it, so setting principal to
# the burner's ~5 USDC gives a 0.25 daily cap, below MIN_FILL_USDC, and no
# trade could ever clear the floor. HARD_CEILING_USDC is what keeps real
# spend small.
VAULT_PRINCIPAL_USDC=1000.00
VAULT_APY_BPS=500
VAULT_OPENING_ACCRUAL_USDC=12.00

# Risk limits
# 🔒 HARD_CEILING_USDC is enforced in code. No request parameter can raise it.
HARD_CEILING_USDC=3.00
MIN_FILL_USDC=0.50
DAILY_CAP_PCT=5

# Market safety
# Measured over 78 consecutive polls: quote TTL sawtooths 57.5s → 117.2s on a
# 60-second cycle, book-wide. A 60s floor rejects the entire book for roughly
# 3 seconds in every 60 (5.1% of polls), which the retry loop absorbs.
QUOTE_MIN_TTL_S=60
MAX_SELECT_RETRIES=3
# The whole book shares one quote expiry, so retrying instantly re-reads the
# same dead window. 4s lands after the maker's refresh.
SELECT_RETRY_DELAY_MS=4000
# Guards the LOCAL clock against the feed's server clock. Measured skew on a
# healthy host is under 1 second.
MAX_CLOCK_SKEW_S=60

# Strike selection (PRD §10.5)
TARGET_DELTA_MIN=-0.20
TARGET_DELTA_MAX=-0.05
MIN_EXPIRY_HOURS=2
# 🔒 Refuse an order whose strike sits further than this from the resolved
# asset's spot. Second, independent guard on the feed→asset map: a mislabelled
# feed puts the strike orders of magnitude away. Live matches are all under 3%.
MAX_STRIKE_DEVIATION_PCT=0.6

# Policy thresholds
TRUTH_THRESHOLD_HEDGE=70
TRUTH_THRESHOLD_FULL=85
AGREEMENT_THRESHOLD=0.60
AGREEMENT_THRESHOLD_FULL=0.75
CLUSTER_COOLDOWN_MINUTES=30

# Attestation
# SELF_TX | EAS | REGISTRY | OFFCHAIN_ONLY. The ladder falls through to
# OFFCHAIN_ONLY on any failure; a failed attestation never fails the hedge.
ATTESTATION_METHOD=SELF_TX

# ─── Stage 02: Investigate (lib/investigate.ts) ─────────────────────────────
# Deterministic evidence gathering that runs BEFORE the models, so a claim is
# scored against measured chain state rather than its own wording. Every value
# here is a tuning knob, not a switch: the stage never fails the pipeline, and
# when it produces nothing the analyst prompt is identical to a build without it.

# Wall clock for the whole stage. A full six-check run measured 1.2-1.7s
# against Base, Chainlink and DeFiLlama, so this is generous headroom rather
# than a target. Checks still pending when it expires are reported as
# unavailable and verification proceeds.
INVESTIGATE_BUDGET_MS=12000
# Ceiling on any single check, so one slow dependency cannot eat the budget.
INVESTIGATE_CHECK_TIMEOUT_MS=8000

# A balance or TVL fall at or beyond this reads as a drain. Measured context:
# ordinary 1h swings in Base DEX depth ran to about 8%, so 15% is set clear of
# routine variance.
INVESTIGATE_DRAIN_PCT=15
# Below this, movement is ordinary flow and contradicts a crisis claim.
INVESTIGATE_NORMAL_PCT=3
# Robust (median/MAD) z at which the transfer rate counts as a spike. Measured
# baseline windows for USDC ranged 833-3273 events, so a mean/sigma score would
# call routine variance a crisis; MAD ignores that tail.
INVESTIGATE_ACTIVITY_Z=3
# DEX-vs-oracle gap that reads as the market moving ahead of the feed. Live
# cross-venue spread on a calm day measured 0.34-0.48%.
INVESTIGATE_DIVERGENCE_PCT=1.5
# A Chainlink answer older than this is called out as stale. Measured staleness
# on 2 Sep 2026: ETH 205s, BTC 235s, SOL 1601s, XRP 1637s, AVAX 3968s, BNB 4450s.
INVESTIGATE_ORACLE_STALE_S=3600
# Protocol TVL fall over 1h that reads as corroboration.
INVESTIGATE_TVL_DROP_PCT=5
# Below this USD value an address's balance is not a proxy for a protocol's
# funds. Measured: Aave's v3 Pool held 114 USDC while reporting billions in TVL,
# because v3 keeps reserves in aTokens.
INVESTIGATE_CUSTODY_FLOOR_USD=25000
# Characters of evidence handed to layer 1. This lands on INPUT; the separate
# 2,048-token completion ceiling was measured safe (median 772, max 842 tokens
# with evidence on, and finish_reason=length never observed). The four simulator
# scenarios render to 2,985-3,151 chars, so this leaves real margin.
INVESTIGATE_PROMPT_CHARS=4000
# How long DeFiLlama's 8.7MB /protocols index stays cached. It is the only free
# endpoint carrying change_1h — /protocol/{slug} is 13-29MB and unusable here.
INVESTIGATE_LLAMA_CACHE_MS=900000

# ─── Stage 01: news ingestion ────────────────────────────────────────────────
# Shared secret for POST /api/webhook/alert. Anything holding this can raise an
# alert, which the pipeline treats as trade eligible, so it is not the same
# secret as OPERATOR_TOKEN and should not be reused as one. Unset means the
# webhook refuses every request.
WEBHOOK_SECRET=
# How often the poller re-reads the four news feeds. They publish a few times
# an hour, so anything under 30s is spent asking a question already answered.
INGEST_POLL_INTERVAL_MS=60000
# Per-feed fetch timeout. Measured on 3 Sep 2026: all four answered in 83-481ms.
FEED_TIMEOUT_MS=12000
# Age past which a headline is not a live threat. Feeds carry roughly a day of
# back catalogue, and about 40% of a fetch is older than this.
TRIAGE_MAX_AGE_HOURS=24
# Whether ingested alerts may place real orders. Off means the pipeline runs the
# whole way and stops short of spending. A live news feed that can trade
# unattended is a different product from the one being demonstrated, so this
# stays off unless somebody turns it on deliberately.
INGEST_LIVE_TRADING=false
