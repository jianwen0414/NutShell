# Chain
THETANUTS_RPC_URL=            # Alchemy/Infura Base Mainnet — NOT mainnet.base.org
THETANUTS_PRIVATE_KEY=        # burner only — worker process only

# Gonka
GONKA_API_KEY=
GONKA_BASE_URL=https://api.gonkarouter.io/v1
# V3 RESOLVED 31 Aug 2026: devshard ids DO resolve on chain, so this is true.
# Set to false only to force the non-linking UI branch.
GONKA_ID_CHAIN_RESOLVABLE=true
# Public Gonka chain REST endpoint. Inferences are recorded here with
# executed_by and response_hash; see `npm run diag:v3`.
GONKA_CHAIN_API=https://node1.gonka.ai:8443/chain-api
# Deferred hedge: send a duplicate analyst call if the first has not finished
# in this long. Gonka support suggested 1.5-2s, but that assumes streaming and
# time-to-first-token; for a non-streaming call that would duplicate every
# request. 14s sits above the normal completion band for the reliable models.
GONKA_HEDGE_AFTER_MS=14000

# Infra
DATABASE_URL=
OPERATOR_TOKEN=

# Vault (simulated). VAULT_PRINCIPAL_USDC is the MODELLED PORTFOLIO, not the
# burner wallet. DAILY_CAP_PCT is a percentage of it, so setting principal to
# the burner's ~5 USDC gives a 0.25 daily cap, below MIN_FILL_USDC, and no
# trade could ever clear the floor. HARD_CEILING_USDC is what keeps real
# spend small.
VAULT_PRINCIPAL_USDC=1000.00
VAULT_APY_BPS=500
VAULT_OPENING_ACCRUAL_USDC=12.00

# Risk limits
HARD_CEILING_USDC=3.00
MIN_FILL_USDC=0.50
DAILY_CAP_PCT=5

# Market safety
QUOTE_MIN_TTL_S=60
MAX_SELECT_RETRIES=3
MAX_CLOCK_SKEW_S=60

# Policy thresholds
TRUTH_THRESHOLD_HEDGE=70
TRUTH_THRESHOLD_FULL=85
AGREEMENT_THRESHOLD=0.60
AGREEMENT_THRESHOLD_FULL=0.75
CLUSTER_COOLDOWN_MINUTES=30

# Attestation
ATTESTATION_METHOD=SELF_TX
