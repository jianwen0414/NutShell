# ─── Chain ──────────────────────────────────────────────────────────────────
# 🔒 Do NOT use https://mainnet.base.org — it is rate-limited and will throttle
# the moment the agent polls in a loop, producing mystery timeouts that look
# like bugs in your own code (PRD §6.2). Use a free Alchemy or Infura key.
THETANUTS_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# 🔒 Burner wallet ONLY, holding just the premium budget (~5 USDC + ~$2 ETH).
# Worker process only — never expose this to a Next.js route (PRD §5.1, §14).
# Leave unset for read-only and dry-run work; every read path works without it.
THETANUTS_PRIVATE_KEY=

# Optional referrer address for OptionBook fee sharing.
THETANUTS_REFERRER=

# ─── Gonka (M2 owns these) ──────────────────────────────────────────────────
GONKA_API_KEY=
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_ID_CHAIN_RESOLVABLE=false

# ─── Infra ──────────────────────────────────────────────────────────────────
DATABASE_URL=
OPERATOR_TOKEN=

# ─── Risk limits (PRD §15) ──────────────────────────────────────────────────
# 🔒 Enforced in code. No request parameter can raise HARD_CEILING_USDC.
HARD_CEILING_USDC=3.00
MIN_FILL_USDC=0.50
DAILY_CAP_PCT=5

# ─── Market safety (PRD §3.5, §3.6) ─────────────────────────────────────────
# Measured over 78 consecutive polls: quote TTL sawtooths 57.5s → 117.2s on a
# 60-second cycle, book-wide. A 60s floor rejects the entire book for roughly
# 3 seconds in every 60 (5.1% of polls), which the retry loop absorbs.
QUOTE_MIN_TTL_S=60
MAX_SELECT_RETRIES=3
# Pause between selection attempts. The whole book shares one quote expiry, so
# retrying instantly re-reads the same dead window; 4s lands after the refresh.
SELECT_RETRY_DELAY_MS=4000
# Guards the LOCAL clock against the feed's server clock. Measured skew on a
# healthy host is under 1 second.
MAX_CLOCK_SKEW_S=60

# ─── Strike selection (PRD §10.5) ───────────────────────────────────────────
TARGET_DELTA_MIN=-0.20
TARGET_DELTA_MAX=-0.05
MIN_EXPIRY_HOURS=2
# 🔒 Refuse an order whose strike sits further than this from the resolved
# asset's spot. Second, independent guard on the feed→asset map: a mislabelled
# feed puts the strike orders of magnitude away. Live matches are all under 3%.
MAX_STRIKE_DEVIATION_PCT=0.6

# ─── Policy thresholds (M2 owns these) ──────────────────────────────────────
TRUTH_THRESHOLD_HEDGE=70
TRUTH_THRESHOLD_FULL=85
AGREEMENT_THRESHOLD=0.60
AGREEMENT_THRESHOLD_FULL=0.75

# ─── Attestation (PRD §12) ──────────────────────────────────────────────────
# SELF_TX | EAS | REGISTRY | OFFCHAIN_ONLY. The ladder falls through to
# OFFCHAIN_ONLY on any failure; a failed attestation never fails the hedge.
ATTESTATION_METHOD=SELF_TX
